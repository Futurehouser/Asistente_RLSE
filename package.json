{
  "name": "asistente-rlse",
  "productName": "Asistente RLSE",
  "version": "1.13.0",
  "description": "Asistente deploy RLSE Aquaplus",
  "main": "main.js",
  "author": "Futurehouser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Futurehouser/Asistente_RLSE.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.futurehouser.asistenterlse",
    "productName": "Asistente RLSE",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Asistente_RLSE.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
